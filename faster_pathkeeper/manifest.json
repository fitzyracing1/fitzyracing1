{
  "manifest_version": 3,
  "name": "Pathkeeper",
  "version": "0.1.0",
  "description": "Save and replay page paths to reduce web memory fatigue.",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": { 
    "default_popup": "popup.html"
  },
  "background": { 
    "service_worker": "background.js" 
  },
  "commands": {
    "save-current-path": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Save current page URL as a path"
    },
    "copy-latest-path": {
      "suggested_key": {
        "default": "Alt+K"
      },
      "description": "Copy the most recently saved path"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["crypto.js"],
      "matches": ["<all_urls>"]
    }
  ]
}