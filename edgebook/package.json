{
  "name": "edgebook-os",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main/main.js",
  "scripts": {
    "dev:renderer": "vite",
    "dev:main": "tsc -w -p electron/tsconfig.json",
    "dev:electron": "node delay-electron.js",
    "dev": "concurrently -n RENDERER,MAIN,ELECTRON -c \"green,yellow,blue\" \"npm run dev:renderer\" \"npm run dev:main\" \"npm run dev:electron\"",
    "build:renderer": "vite build",
    "build:main": "tsc -p electron/tsconfig.json",
    "build": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dist:win": "electron-builder --win"
  },
  "build": {
    "appId": "com.edgebook.os",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vite": "^5.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0",
    "electron-builder": "^24.10.2",
    "@types/node": "^20.0.0"
  },
  "dependencies": {
    "electron": "^30.0.0",
    "electron-edge-js": "^17.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
