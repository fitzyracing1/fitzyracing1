{
  "manifest_version": 3,
  "name": "Pathkeeper",
  "version": "0.1.1",
  "description": "Save and replay page paths to reduce web memory fatigue.",
  "icons": { "128": "icon128.png" },
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon128.png" } },
  "background": { "service_worker": "background.js" },
  "commands": {
    "save_step": {
      "suggested_key": { "default": "Alt+S" },
      "description": "Save current step"
    },
    "open_paths": {
      "suggested_key": { "default": "Alt+K" },
      "description": "Open saved paths"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
